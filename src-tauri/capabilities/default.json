{
  "$schema": "../gen/schema",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:app:default",
    "core:app:allow-version",
    "core:app:allow-name",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "shell:default",
    "shell:allow-execute",
    "shell:allow-open",
    "shell:allow-sidecar",
    "shell:allow-kill",
    "shell:allow-spawn"
  ]
}
